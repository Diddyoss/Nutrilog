# Frontend (safe to expose — protected by Supabase RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only — used by /api/analyze-food on Vercel. NEVER prefix with VITE_.
OPENROUTER_API_KEY=
# Optional — any vision-capable OpenRouter model. Defaults to anthropic/claude-3.5-sonnet.
# Examples: openai/gpt-4o-mini, google/gemini-flash-1.5, anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=
