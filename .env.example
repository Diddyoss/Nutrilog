# Frontend (safe to expose — protected by Supabase RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only — used by /api/analyze-food and /api/coach on Vercel. NEVER prefix with VITE_.
OPENROUTER_API_KEY=
# Optional — any vision-capable OpenRouter model for photo analysis. Defaults to google/gemini-3-flash-preview.
OPENROUTER_MODEL=
# Optional — coach primary model. Defaults to deepseek/deepseek-v4-flash.
COACH_MODEL=
# Optional — coach fallback model (different provider family on purpose). Defaults to google/gemini-3-flash-preview.
COACH_FALLBACK_MODEL=
